#!/usr/bin/env bash
# dev-up — bring up the local docker-compose stack.

set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v docker >/dev/null 2>&1; then
  echo "docker not installed. Install Docker Desktop or docker-ce." >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "docker daemon is not running. Start Docker Desktop or dockerd." >&2
  exit 1
fi

# Ensure .env exists.
if [ ! -f .env ]; then
  echo ".env not found. Run ./bin/bootstrap first." >&2
  exit 1
fi

# shellcheck disable=SC1091
set -a; source .env; set +a

docker compose -f infrastructure/local/docker-compose.yml up -d --remove-orphans

echo
echo "Waiting for services to become healthy..."
timeout 120 bash -c '
  until docker compose -f infrastructure/local/docker-compose.yml ps --status running 2>/dev/null | grep -q "domio-postgres.*healthy"; do
    sleep 2
  done
' || true

echo
echo "Services:"
docker compose -f infrastructure/local/docker-compose.yml ps --format 'table {{.Name}}\t{{.Status}}\t{{.Ports}}' || true

echo
echo "Endpoints:"
echo "  Editor:    http://localhost:3000  (after ./bin/dev)"
echo "  API:       http://localhost:8080"
echo "  Health:    http://localhost:8080/healthz"
echo "  Ready:     http://localhost:8080/readyz"
echo "  Postgres:  localhost:5432  (domio / domio)"
echo "  MinIO UI:  http://localhost:9001  (domio / domio-dev-only)"
echo "  Grafana:   http://localhost:3001  (admin / admin)"
echo "  Jaeger:    http://localhost:16686"
echo "  Prometheus: http://localhost:9090"