#!/usr/bin/env bash
# lint — run every lint suite across the monorepo.

set -euo pipefail

cd "$(dirname "$0")/.."

echo "→ prettier --check"
pnpm format:check

echo "→ turbo run lint"
pnpm lint

echo "→ golangci-lint (if installed)"
if command -v golangci-lint >/dev/null 2>&1 && [ -f go.mod ]; then
  golangci-lint run ./...
fi

echo "→ ruff (if installed)"
if command -v ruff >/dev/null 2>&1; then
  ruff check .
fi

echo "→ buf lint"
if command -v buf >/dev/null 2>&1 && [ -d contracts/proto ]; then
  buf lint contracts/proto
fi

echo "Lint complete."