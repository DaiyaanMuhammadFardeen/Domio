{
  "name": "@domio/migration-lint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "domio-migration-lint": "./dist/cli.mjs"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:migrations": "node dist/cli.mjs lint --rules-dir rules --migrations ../../infrastructure/postgres/migrations --strict"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.1"
  }
}
