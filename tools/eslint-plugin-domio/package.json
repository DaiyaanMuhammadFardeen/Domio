{
  "name": "@domio/eslint-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Custom ESLint rules for Domio (no-raw-href, no-raw-fetch, no-raw-hex).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
