{
  "$schema": "https://docs.docker.com/engine/schema/registry-config.json",
  "_comment": "Docker daemon config generated by infrastructure/mirrors/apply.sh. The single registry-mirrors entry routes pull-through pulls for any image to the regional registry. The file is intentionally minimal; no auth is configured here.",
  "registry-mirrors": [
    "${MIRROR_DOCKER_URL}"
  ],
  "max-concurrent-downloads": 10,
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
