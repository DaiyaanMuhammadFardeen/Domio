# pip user-scope config generated by infrastructure/mirrors/apply.sh
#
# This is the canonical user-scope pip config for Bangladesh development. It
# points pip at the regional PyPI mirror. pip does not natively support a
# fallback index, so the mirror ITSELF is configured (in
# devpi-nginx.conf.example) to proxy through to the upstream on cache miss.
#
# Variables resolved at apply time:
#   MIRROR_PYPI_URL — full URL of the regional PyPI mirror
#   PYPI_UPSTREAM   — upstream URL (kept here as a comment for reference; not
#                     actively used by pip, but used by healthcheck.sh)

[global]
index-url = ${MIRROR_PYPI_URL}/+simple/
# extra-index-url is dangerous: pip will query BOTH and pick the latest,
# which can be a supply-chain risk. We deliberately do NOT set it.
trusted-host =
    # Add mirror hostname here only if you serve over plain http.
    # In production the mirror is behind HTTPS, so this list is empty.
timeout = 120
retries = 5

# Cache + no-cache-dir: bandwidth-friendly defaults.
cache-dir = ${XDG_CACHE_HOME:-~/.cache}/pip
