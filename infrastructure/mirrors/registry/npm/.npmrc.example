# npm user-scope config generated by infrastructure/mirrors/apply.sh
#
# This file is the canonical user-scope npm config. It points npm at the
# regional mirror and lists the upstream as a fallback registry.
#
# Variables (resolved at apply time):
#   MIRROR_NPM_URL  — full URL of the regional mirror
#   NPM_UPSTREAM    — full URL of the upstream registry
#
# Security:
#   - NEVER add //registry.example.com/:_authToken=... here. The apply.sh
#     script refuses to write a file that contains a `_authToken` line.
#   - If you need an authenticated mirror, configure it via ~/.npmrc and keep
#     the auth line OUTSIDE this generated file.

registry=${MIRROR_NPM_URL}
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
# `audit` and `fund` talk to registry.npmjs.org; redirect them too so we
# don't open a second trans-continental connection.
audit-level=low
# Always include the upstream so an `npm config get registry` still works
# even if the mirror is unreachable.
# (npm does not natively support a "fallback" registry, so fallback is
#  implemented at the proxy level — see verdaccio-config.example.yaml.)
