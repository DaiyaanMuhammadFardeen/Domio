{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Phase 21 — Recording & Studio",
  "tags": ["phase-21", "recording", "transcript", "clip", "replay", "paywall"],
  "templating": {
    "list": [
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(recording_orchestrator_started_total, workspace_id)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Recordings started (5m)",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(recording_orchestrator_started_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "started",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "stat",
      "title": "Chunks committed (5m)",
      "id": 2,
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(recording_orchestrator_chunk_committed_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "chunks",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "stat",
      "title": "Chunk commit conflicts (5m)",
      "id": 3,
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(recording_orchestrator_chunk_conflict_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "conflicts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Failed recordings (5m)",
      "id": 4,
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(recording_orchestrator_failed_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Finalized recordings (5m)",
      "id": 5,
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(recording_orchestrator_finalized_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "finalized",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Recording lifecycle (rate/s)",
      "id": 6,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (event) (rate({__name__=~\"recording_orchestrator_(started|paused|resumed|stopped|finalized|failed)_total\"}[5m]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Chunk commits by track (rate/s)",
      "id": 7,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (track_kind) (rate(recording_orchestrator_chunk_committed_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "{{track_kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "stat",
      "title": "Transcript STT provider attempts (5m)",
      "id": 8,
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum by (provider) (increase(transcript_service_stt_provider_attempts_total{workspace_id=~\"$workspace\"}[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "Clip render lease wait p95 (s)",
      "id": 9,
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(clip_engine_lease_wait_seconds_bucket{workspace_id=~\"$workspace\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Replay viewer concurrent",
      "id": 10,
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(replay_web_active_sessions{workspace_id=~\"$workspace\"})",
          "legendFormat": "viewers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 150 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Paywall checkout p95 (ms)",
      "id": 11,
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(paywall_service_checkout_seconds_bucket{workspace_id=~\"$workspace\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 800 },
              { "color": "red", "value": 1500 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Hash chain verification (24h)",
      "id": 12,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (chain) (rate(audit_verifier_verified_total{workspace_id=~\"$workspace\"}[1h]))",
          "legendFormat": "{{chain}} verified",
          "refId": "A"
        },
        {
          "expr": "sum by (chain) (rate(audit_verifier_mismatch_total{workspace_id=~\"$workspace\"}[1h]))",
          "legendFormat": "{{chain}} mismatch",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "stat",
      "title": "SCORM pack p95 (s)",
      "id": 13,
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(replay_scorm_packager_job_seconds_bucket{workspace_id=~\"$workspace\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Search query p95 (ms)",
      "id": 14,
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(search_service_query_seconds_bucket{workspace_id=~\"$workspace\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 800 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" }
}
