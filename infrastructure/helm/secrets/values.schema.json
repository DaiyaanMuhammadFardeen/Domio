{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secrets chart values schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["vault", "secrets", "oncall", "refreshInterval", "image"],
  "properties": {
    "vault": {
      "type": "object",
      "required": ["address", "authMethod", "role"],
      "properties": {
        "address": { "type": "string", "format": "uri" },
        "authMethod": {
          "type": "string",
          "enum": ["kubernetes", "token", "approle"]
        },
        "authPath": { "type": "string" },
        "mountPath": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
      }
    },
    "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "namespace", "backend", "path", "keys", "template"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "namespace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "backend": { "type": "string", "enum": ["vault"] },
          "path": { "type": "string", "pattern": "^[a-z0-9/.-]+$" },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" }
          },
          "template": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["Opaque", "kubernetes.io/tls", "kubernetes.io/dockerconfigjson"] },
              "metadata": {
                "type": "object",
                "properties": {
                  "labels": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  },
                  "annotations": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "oncall": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "configMapName": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "readOnlyRootFilesystem": { "type": "boolean", "const": true },
        "allowPrivilegeEscalation": { "type": "boolean", "const": false },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": { "type": "string" }
          }
        }
      }
    }
  }
}
