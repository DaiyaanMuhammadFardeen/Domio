{
  "name": "@domio/clickhouse-migrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 17 — ClickHouse migration CLI. Applies ordered .sql files from init/ and tracks applied migrations in a domio_analytics.__migrations table.",
  "scripts": {
    "migrate:up": "tsx src/cli.ts up",
    "migrate:down": "tsx src/cli.ts down",
    "migrate:status": "tsx src/cli.ts status",
    "migrate:verify": "tsx src/cli.ts verify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
