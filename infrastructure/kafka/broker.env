# Phase 17 — Kafka broker env defaults (used by services/event-ingest & consumers).
#
# These mirror what production brokers expose. Keep these in lock-step with
# /infrastructure/terraform/modules/kafka/outputs.tf.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SASL_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=domio
KAFKA_SASL_PASSWORD=domio

# Topics created by services/event-ingest on first publish (auto.create).
KAFKA_TOPIC_INGEST_RAW=events.ingest.raw
KAFKA_TOPIC_INGEST_NORMALIZED=events.ingest.normalized
KAFKA_TOPIC_SESSION=session.events
KAFKA_TOPIC_CRM_QUEUED=crm.sync.queued
KAFKA_TOPIC_CRM_SENT=crm.sync.sent
KAFKA_TOPIC_CRM_FAILED=crm.sync.failed
KAFKA_TOPIC_CRM_DLQ=crm.dlq
KAFKA_TOPIC_NOTIFICATION_TRIGGERED=notification.triggered
KAFKA_TOPIC_NOTIFICATION_SENT=notification.sent
KAFKA_TOPIC_NOTIFICATION_FAILED=notification.failed
KAFKA_TOPIC_EXPERIMENT_CONCLUDED=experiment.concluded
KAFKA_TOPIC_HEATMAP_REFRESHED=heatmap.refreshed
KAFKA_TOPIC_LIVE_SUMMARY=live_session_summary.generated
KAFKA_TOPIC_TEAM_REFRESHED=team_analytics.refreshed
KAFKA_TOPIC_CONSENT=consent.events

# Consumer group IDs.
KAFKA_GROUP_COLUMNAR_LOADER=columnar-loader
KAFKA_GROUP_SESSIONIZATION=sessionization
KAFKA_GROUP_CRM_SYNC=crm-sync
KAFKA_GROUP_NOTIFICATION_DISPATCHER=notification-dispatcher
KAFKA_GROUP_HEATMAP=heatmap-generator
KAFKA_GROUP_TEAM_ANALYTICS=team-analytics
KAFKA_GROUP_LIVE_ANALYTICS=live-analytics
KAFKA_GROUP_AB_MEASUREMENT=ab-measurement
KAFKA_GROUP_SESSION_ARCHIVER=session-archiver
