<?xml version="1.0"?>
<!--
  Phase 17 — ClickHouse server config overrides for the dev container.

  Mounted at /etc/clickhouse-server/config.d/00-phase17.xml on top of the
  default config that ships in the alpine image. Production configs are
  generated by /infrastructure/terraform/modules/clickhouse/.

  Settings tuned for:
    * 200k events/sec ingest burst (W1 SLO)
    * ClickHouse p95 < 2s for top 20 dashboard queries (W11 SLO)
    * Lightweight DELETE for GDPR erasure (R6 in the risk register)
-->
<domio>
    <openSSL>
        <server>
            <certificateFile>/etc/clickhouse-server/server.crt</certificateFile>
            <privateKeyFile>/etc/clickhouse-server/server.key</privateKeyFile>
            <dhParamsFile>/etc/clickhouse-server/dhparam.pem</dhParamsFile>
            <verificationMode>none</verificationMode>
            <loadDefaultCAFile>true</loadDefaultCAFile>
            <cacheSessions>true</cacheSessions>
            <disableProtocols>sslv2,sslv3</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
    </openSSL>

    <!-- Network: bind everywhere inside the container; ports exposed by compose. -->
    <listen_host>0.0.0.0</listen_host>

    <!-- Concurrency knobs. -->
    <max_connections>4096</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>
    <max_concurrent_queries>200</max_concurrent_queries>
    <uncompressed_cache_size>1073741824</uncompressed_cache_size>
    <mark_cache_size>1073741824</mark_cache_size>
    <max_server_memory_usage>0</max_server_memory_usage>
    <max_thread_pool_size>10000</max_thread_pool_size>
    <total_memory_profiler_step>4194304</total_memory_profiler_step>

    <!-- Merge scheduling tuned for high ingest throughput. -->
    <background_pool_size>16</background_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_fetches_pool_size>8</background_fetches_pool_size>

    <!-- Storage policy: single volume, no tiering in dev. -->
    <storage_configuration>
        <disks>
            <default>
                <keep_free_space_bytes>0</keep_free_space_bytes>
            </default>
        </disks>
        <policies>
            <default>
                <volumes>
                    <main>
                        <disk>default</disk>
                    </main>
                </volumes>
            </default>
        </policies>
    </storage_configuration>

    <!-- Macros injected into every query so analytics-warehouse can target
         shards by workspace_id without a separate routing table. -->
    <macros>
        <shard>1</shard>
        <replica>dev-1</replica>
    </macros>

    <!-- Remote query defaults for the analytics-warehouse client. -->
    <remote_servers>
        <domio_analytics_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </domio_analytics_cluster>
    </remote_servers>

    <!-- Zookeeper not used (KRaft only); explicit empty block. -->
    <zookeeper incl="zookeeper" optional="true" />

    <!-- Enable query_log + metric_log for the Phase 17 Grafana dashboard. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <engine>Engine = MergeTree ORDER BY event_time TTL event_time + INTERVAL 30 DAY DELETE</engine>
    </query_log>
    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <engine>Engine = MergeTree ORDER BY event_time TTL event_time + INTERVAL 30 DAY DELETE</engine>
    </metric_log>
</domio>
