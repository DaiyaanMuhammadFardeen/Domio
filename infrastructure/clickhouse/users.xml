<?xml version="1.0"?>
<!--
  Phase 17 — ClickHouse user definitions.

  Three roles:
    * domio / domio — application service account (event-ingest,
      columnar-loader, analytics-warehouse, heatmap-generator,
      team-analytics, notification-dispatcher, viewer-identity).
    * domio_readonly — dashboard GraphQL gateway read-only.
    * domio_admin — migration / DDL; not exposed to app code.

  Passwords are sourced from env vars mounted into /etc/clickhouse-server
  users.d/00-phase17.xml.d/ in production; this file is the dev override.
-->
<domio>
    <users>
        <domio>
            <password>domio</password>
            <networks incl="networks" replace="replace">
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </domio>

        <domio_readonly>
            <password>domio_readonly</password>
            <networks incl="networks" replace="replace">
                <ip>::/0</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </domio>

        <domio_admin>
            <password>domio_admin</password>
            <networks incl="networks" replace="replace">
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </domio>
    </users>

    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <readonly>0</readonly>
        </default>

        <readonly>
            <readonly>1</readonly>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </readonly>
    </profiles>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</domio>
