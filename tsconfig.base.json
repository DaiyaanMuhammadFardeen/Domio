{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "composite": false,
    "paths": {
      "@domio/common": ["./packages/common/src/index.ts"],
      "@domio/common/*": ["./packages/common/src/*"],
      "@domio/schema": ["./packages/schema/src/index.ts"],
      "@domio/schema/*": ["./packages/schema/src/*"],
      "@domio/ui": ["./packages/ui/src/index.ts"],
      "@domio/ui/*": ["./packages/ui/src/*"],
      "@domio/tokens": ["./packages/tokens/src/index.ts"],
      "@domio/tokens/*": ["./packages/tokens/src/*"],
      "@domio/api-client": ["./packages/api-client/src/index.ts"],
      "@domio/api-client/*": ["./packages/api-client/src/*"],
      "@domio/canvas": ["./packages/canvas/src/index.ts"],
      "@domio/canvas/*": ["./packages/canvas/src/*"],
      "@domio/deep-link": ["./packages/deep-link/src/index.ts"],
      "@domio/deep-link/*": ["./packages/deep-link/src/*"],
      "@domio/prototype-runtime": ["./packages/prototype-runtime/src/index.ts"],
      "@domio/prototype-runtime/*": ["./packages/prototype-runtime/src/*"],
      "@domio/animation-runtime": ["./packages/animation-runtime/src/index.ts"],
      "@domio/animation-runtime/*": ["./packages/animation-runtime/src/*"],
      "@domio/agent-schema": ["./packages/agent-schema/src/index.ts"],
      "@domio/agent-schema/*": ["./packages/agent-schema/src/*"],
      "@domio/audio": ["./packages/audio/src/index.ts"],
      "@domio/audio/*": ["./packages/audio/src/*"],
      "@domio/easing": ["./packages/easing/src/index.ts"],
      "@domio/easing/*": ["./packages/easing/src/*"],
      "@domio/physics": ["./packages/physics/src/index.ts"],
      "@domio/physics/*": ["./packages/physics/src/*"],
      "@domio/recording": ["./packages/recording/src/index.ts"],
      "@domio/recording/*": ["./packages/recording/src/*"],
      "@domio/video": ["./packages/video/src/index.ts"],
      "@domio/video/*": ["./packages/video/src/*"],
      "@domio/model-adapter": ["./packages/model-adapter/src/index.ts"],
      "@domio/model-adapter/*": ["./packages/model-adapter/src/*"],
      "@domio/prompt-registry": ["./packages/prompt-registry/src/index.ts"],
      "@domio/prompt-registry/*": ["./packages/prompt-registry/src/*"],
      "@domio/i18n": ["./packages/i18n/src/index.ts"],
      "@domio/i18n/*": ["./packages/i18n/src/*"],
      "@domio/annotation-engine": ["./services/annotation-engine/src/index.ts"],
      "@domio/annotation-engine/*": ["./services/annotation-engine/src/*"],
      "@domio/ar-sessions": ["./services/ar-sessions/src/index.ts"],
      "@domio/ar-sessions/*": ["./services/ar-sessions/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo", "**/gen/**", "**/generated/**"]
}
