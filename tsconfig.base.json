{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "composite": false,
    "paths": {
      "@domio/common": ["./packages/common/src/index.ts"],
      "@domio/common/*": ["./packages/common/src/*"],
      "@domio/schema": ["./packages/schema/src/index.ts"],
      "@domio/schema/*": ["./packages/schema/src/*"],
      "@domio/contracts": ["./packages/contracts/src/index.ts"],
      "@domio/contracts/*": ["./packages/contracts/src/*"],
      "@domio/ui": ["./packages/ui/src/index.ts"],
      "@domio/ui/*": ["./packages/ui/src/*"],
      "@domio/tokens": ["./packages/tokens/src/index.ts"],
      "@domio/tokens/*": ["./packages/tokens/src/*"],
      "@domio/api-client": ["./packages/api-client/src/index.ts"],
      "@domio/api-client/*": ["./packages/api-client/src/*"],
      "@domio/canvas": ["./packages/canvas/src/index.ts"],
      "@domio/canvas/*": ["./packages/canvas/src/*"],
      "@domio/deep-link": ["./packages/deep-link/src/index.ts"],
      "@domio/deep-link/*": ["./packages/deep-link/src/*"],
      "@domio/prototype-runtime": ["./packages/prototype-runtime/src/index.ts"],
      "@domio/prototype-runtime/*": ["./packages/prototype-runtime/src/*"],
      "@domio/formula-engine": ["./packages/formula-engine/src/index.ts"],
      "@domio/formula-engine/*": ["./packages/formula-engine/src/*"],
      "@domio/animation-runtime": ["./packages/animation-runtime/src/index.ts"],
      "@domio/animation-runtime/*": ["./packages/animation-runtime/src/*"],
      "@domio/agent-schema": ["./packages/agent-schema/src/index.ts"],
      "@domio/agent-schema/*": ["./packages/agent-schema/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo", "**/gen/**", "**/generated/**"]
}