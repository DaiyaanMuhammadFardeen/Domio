# EditorConfig is awesome: https://EditorConfig.org
# Top-most EditorConfig file.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.go]
indent_style = tab
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{rs,toml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
