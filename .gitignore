# Generated
**/gen/
# `packages/schema/src/generated/` is intentionally NOT ignored: those files
# are the hand-written source of truth for the v1 deck scene graph types
# consumed by every other package. The JSON-Schema → TypeScript generator is
# a P02 follow-up; until it lands these files are committed.
**/*.pb.go
**/*.pb.cc
**/*.pb.h
**/_pb2.py
**/_pb2_grpc.py
**/node_modules/
**/target/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/

# Docker
.docker/
docker-compose.override.yml

# Local data
data/
*.sqlite
*.sqlite3
*.db
pgdata/
redisdata/
natsdata/
miniodata/
clickhousedata/
opensearchdata/

# Secrets
*.pem
*.key
*.crt
# Only ignore top-level `secrets/` (operational credential storage).
# Subpaths like `infrastructure/helm/secrets/` are legitimate Helm
# charts that *manage* credentials; they must be tracked.
/secrets/

