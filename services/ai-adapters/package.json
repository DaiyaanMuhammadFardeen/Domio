{
  "name": "@domio/ai-adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio AI adapters gRPC server — hosts model-adapter + prompt-registry for the Go orchestrator. Phase 12 AI Copilot.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/model-adapter": "workspace:*",
    "@domio/prompt-registry": "workspace:*",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
