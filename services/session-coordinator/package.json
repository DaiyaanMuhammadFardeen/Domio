{
  "name": "@domio/session-coordinator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 16 W1 — Cross-shard coordinator for participant sessions. Aggregates session_membership across shards, exposes fan-out metadata for the WS gateway.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/audience-service": "workspace:^",
    "@domio/participant-session": "workspace:*",
    "@domio/session-code": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}