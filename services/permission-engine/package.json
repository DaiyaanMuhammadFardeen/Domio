{
  "name": "@domio/permission-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Permission engine — hierarchical RBAC with deny-overrides, ancestry blocking, temporal grants, group membership, and workspace role baselines. Phase 18.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "^8.20.3",
    "pg": "^8.22.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@domio/observability": "workspace:*"
  }
}
