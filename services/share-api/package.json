  },
  "dependencies": {
    "@domio/audit-ts": "workspace:*",
    "@domio/signed-link-token": "workspace:*",
    "@domio/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "^8.20.3",
    "pg": "^8.22.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
