{
  "name": "@domio/share-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Share-link data plane (Phase 14 W1). REST CRUD on share_link + signed tokens + audit emission.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
