{
  "name": "@domio/localization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Locale-aware formatting, decimal arithmetic, and exchange-rate management for Phase 08.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
