{
  "name": "@domio/connector-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Connector framework — adapter interface, registry, auth, canonical normalization, PII detection, retry. Phase 08.",
  "main": "src/index.ts",
