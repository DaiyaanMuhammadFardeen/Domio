{
  "name": "@domio/analytics-warehouse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 17 W2 — Read API + rollup orchestrator over ClickHouse. Surfaces REST + GraphQL endpoints that the dashboard consumes.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
