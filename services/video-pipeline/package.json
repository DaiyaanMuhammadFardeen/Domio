{
  "name": "@domio/video-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Video transcode pipeline service — job orchestration, transcoding, caption extraction, waveform metadata. Phase 11.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
