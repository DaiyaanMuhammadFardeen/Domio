{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "types": [],
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "paths": {
      "@domio/chart": ["../../packages/chart/src/index.ts"],
      "@domio/chart/*": ["../../packages/chart/src/*"],
      "@domio/i18n": ["../../packages/i18n/src/index.ts"],
      "@domio/i18n/*": ["../../packages/i18n/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
