{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "paths": {
      "@domio/chart": ["../../packages/chart/src/index.ts"],
      "@domio/chart/*": ["../../packages/chart/src/*"],
      "@domio/observability": ["../../packages/observability/src/index.ts"],
      "@domio/observability/*": ["../../packages/observability/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
