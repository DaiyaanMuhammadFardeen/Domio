{
  "name": "@domio/viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio read-only web viewer — playback engine for shared decks, live sessions, and embedded presentations.",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3001",
    "start": "next start -p 3001",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next dist .turbo coverage"
  },
  "dependencies": {
    "@domio/analytics-sdk": "workspace:*",
    "@domio/animation-runtime": "workspace:*",
    "@domio/ar-sessions": "workspace:*",
    "@domio/audio": "workspace:*",
    "@domio/easing": "workspace:*",
    "@domio/embed-proxy": "workspace:*",
    "@domio/lottie": "workspace:*",
    "@domio/maps": "workspace:*",
    "@domio/physics": "workspace:*",
    "@domio/video": "workspace:*",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}