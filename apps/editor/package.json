{
  "name": "@domio/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio editor — Phase 0 stub. Real canvas editor (Next.js 15 + Vite + WebGL2/WebGPU) lands in Phase 03.",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "dev:3100": "next dev -p 3100",
    "start": "next start -p 3000",
    "start:3100": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "clean": "rm -rf .next dist .turbo coverage test-results"
  },
  "dependencies": {
    "@domio/api-client": "workspace:*",
    "@domio/canvas": "workspace:*",
    "@domio/common": "workspace:*",
    "@domio/components": "workspace:*",
    "@domio/deep-link": "workspace:*",
    "@domio/i18n": "workspace:*",
    "@domio/observability": "workspace:*",
    "@domio/prototype-runtime": "workspace:*",
    "@domio/recording": "workspace:*",
    "@domio/recording-extensions": "workspace:*",
    "@domio/object-store": "workspace:*",
    "@domio/schema": "workspace:*",
    "@domio/schema-prop": "workspace:*",
    "@domio/sdk": "workspace:*",
    "@domio/web-security": "workspace:*",
    "@domio/yjs-shared": "workspace:*",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "15.1.3",
    "postcss": "^8.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "^4.12.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
