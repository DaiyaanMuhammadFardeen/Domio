{
  "name": "@domio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio control plane (Phase 0 stub). Modular monolith in TypeScript on Hono + Node 22. Real modules land in Phase 02+.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/common": "workspace:*",
    "@hono/node-server": "1.13.7",
    "@hono/zod-validator": "0.4.1",
    "hono": "4.6.13",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}