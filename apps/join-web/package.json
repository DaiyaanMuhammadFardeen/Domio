{
  "name": "@domio/join-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio PWA — audience mobile join. Phase 16 W1. Scans a QR, joins a session, renders widgets (poll/qa/quiz/etc).",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3003",
    "start": "next start -p 3003",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next dist .turbo coverage"
  },
  "dependencies": {
    "@domio/analytics-sdk": "workspace:*",
    "@domio/audience-service": "workspace:^",
    "@domio/edge-pubsub": "workspace:*",
    "@domio/participant-session": "workspace:*",
    "@domio/protocol": "workspace:*",
    "@domio/session-code": "workspace:*",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
