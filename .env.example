# Domio — root environment variable template.
# Copy this file to `.env` for local development. CI overrides these via secrets.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
DOMIO_ENV=local
NODE_ENV=development
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Services (HTTP/RPC endpoints — local docker-compose default ports)
# -----------------------------------------------------------------------------
API_HTTP_URL=http://localhost:8080
API_GRPC_URL=localhost:8081
REALTIME_GATEWAY_URL=ws://localhost:8082
REALTIME_GATEWAY_GRPC=localhost:8083

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://domio:domio@localhost:5432/domio
POSTGRES_USER=domio
POSTGRES_PASSWORD=domio
POSTGRES_DB=domio
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis / NATS / object storage
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=domio
S3_SECRET_KEY=domio-dev-only
S3_BUCKET=domio-assets
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Analytics warehouse + search
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=domio_analytics
CLICKHOUSE_USER=domio
CLICKHOUSE_PASSWORD=domio

OPENSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=domio-dev
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# -----------------------------------------------------------------------------
# Auth (stub in P00; real auth in P20)
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=dev-only-do-not-use-in-prod-9b3f
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Feature flags (off by default)
# -----------------------------------------------------------------------------
FEATURE_FLAGS=http://localhost:8080/v1/flags
FLAG_DEFAULT=on

# -----------------------------------------------------------------------------
# Worker scaling (local defaults)
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# AI (empty in P00; real keys land in P12)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=