{
  "title": "reaction-broadcaster — Service Overview",
  "uid": "domio-reaction-broadcaster",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "tier-2",
    "domio",
    "reaction-broadcaster"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"reaction-broadcaster\"}[1m]))",
          "legendFormat": "rps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (%)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"reaction-broadcaster\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{service=\"reaction-broadcaster\"}[1m]))",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95 (ms)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"reaction-broadcaster\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "avail-reaction-broadcaster (target 99.5%)",
      "gridPos": {
        "x": 3,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_requests_total{service=\"reaction-broadcaster\",status=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"reaction-broadcaster\"}[1h])))",
          "legendFormat": "avail-reaction-broadcaster"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
