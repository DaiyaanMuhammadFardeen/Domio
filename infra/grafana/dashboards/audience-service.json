{
  "title": "Audience Service — Service Overview",
  "uid": "domio-audience",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "tags": ["tier-1", "domio", "audience"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"audience\"}[1m]))",
          "legendFormat": "rps"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (%)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"audience\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{service=\"audience\"}[1m]))",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95 (ms)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"audience\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "avail-audience (target 99.9%)",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_requests_total{service=\"audience\",status=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"audience\"}[1h])))",
          "legendFormat": "avail-audience"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "lat-audience-render-p95 (target < 250 ms)",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_request_duration_seconds_bucket{service=\"audience\",le=\"0.25\"}[1h])) / sum(rate(http_request_duration_seconds_count{service=\"audience\"}[1h])))",
          "legendFormat": "lat-audience-render-p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {}
    }
  ]
}
