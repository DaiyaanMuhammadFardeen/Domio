{
  "name": "@domio/prototype-recorder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 10 M5 client-side recorder and replay engine. sendBeacon / fetch(keepalive) fallback, IndexedDB queue, replay at 1×/2×/4×, click heatmap aggregation.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/prototype-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "jsdom": "^25.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "fake-indexeddb": "6.0.0"
  }
}
