{
  "name": "@domio/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio observability SDK — OTLP HTTP exporter, trace/metrics/log APIs, PII redaction, no-op fallback. Phase 01 Stream B.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./trace": {
      "types": "./src/trace.ts",
      "default": "./dist/trace.js"
    },
    "./metrics": {
      "types": "./src/metrics.ts",
      "default": "./dist/metrics.js"
    },
    "./logs": {
      "types": "./src/logs.ts",
      "default": "./dist/logs.js"
    },
    "./resource": {
      "types": "./src/resource.ts",
      "default": "./dist/resource.js"
    },
    "./redaction": {
      "types": "./src/redaction.ts",
      "default": "./dist/redaction.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts src test",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/redact-pii": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
