{
  "name": "@domio/yjs-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yjs CRDT substrate for Domio: sub-doc shaping, awareness, persistence, offline queue.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/schema": "workspace:*",
    "lib0": "0.2.106",
    "y-protocols": "1.0.6",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
