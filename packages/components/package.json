{
  "name": "@domio/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domio curated component pack — declarative SVG scene-graph components with JSON-Schema props and variants (Phase 06 WS-COM-1/2).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/schema": "workspace:*",
    "@domio/schema-prop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
