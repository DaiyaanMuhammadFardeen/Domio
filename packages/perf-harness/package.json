{
  "name": "@domio/perf-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frame-time and replay harness for canvas + CRDT perf regression. Phase 22-beta G1-2.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./frame": "./src/frame.ts",
    "./replay": "./src/replay.ts",
    "./report": "./src/report.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/schema": "workspace:*",
    "@domio/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}