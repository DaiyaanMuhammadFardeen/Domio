{
  "name": "@domio/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Common TypeScript utilities — IDs, time, money, errors, idempotency. Used by every app, service, and worker.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}