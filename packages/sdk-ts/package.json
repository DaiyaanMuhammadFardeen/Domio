{
  "name": "@domio/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public Domio SDK entrypoint. Re-exports @domio/schema and ships the ClientDocumentLoader + AutosaveQueue plumbing.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader.ts",
    "./autosave-queue": "./src/autosave-queue.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}