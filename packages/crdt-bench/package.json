{
  "name": "@domio/crdt-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CRDT convergence benchmark: 1k concurrent editors on one deck. Phase 22-beta G1-4.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./harness": "./src/harness.ts",
    "./scenarios": "./src/scenarios.ts",
    "./report": "./src/report.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@domio/yjs-shared": "workspace:*",
    "@domio/schema": "workspace:*",
    "@domio/common": "workspace:*",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}