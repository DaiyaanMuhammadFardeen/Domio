{
  "name": "@domio/signed-link-token",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Signed-link-token primitives for Phase 14 W1 (share-link data plane). Crockford base32 short-id, HMAC-SHA256 mint/verify, nonce store.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
