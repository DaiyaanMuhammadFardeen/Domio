{
  "name": "@domio/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical Domio deck JSON Schema and TypeScript scene-graph types.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/scene-graph": "./src/generated/scene-graph.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "eslint": "9.17.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
