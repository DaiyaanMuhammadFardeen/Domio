{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.dev/contracts/mcp/tools/accessibility_audit.output.schema.json",
  "title": "AccessibilityAuditOutput",
  "description": "Output of the accessibility_audit MCP tool.",
  "type": "object",
  "required": ["deck_id", "findings", "tool_version"],
  "additionalProperties": false,
  "properties": {
    "deck_id": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "slide", "message"],
        "additionalProperties": false,
        "properties": {
          "code":     { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "slide":    { "type": "integer", "minimum": 0 },
          "message":  { "type": "string" }
        }
      }
    },
    "tool_version": { "type": "string" }
  }
}
