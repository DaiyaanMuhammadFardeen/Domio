{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/schemas/v1/embed-policy-v1.schema.json",
  "title": "Domio Embed Policy V1",
  "description": "Live-app iframe embedding policy for Phase 11. Defines allowed origins, sandbox flags, JWT requirements, and focus-trap settings.",
  "type": "object",
  "required": ["schemaVersion", "id", "workspaceId", "name", "allowedOrigins", "sandboxFlags", "jwtRequired", "trapFocus", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allowedOrigins": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 1,
      "description": "Origins permitted inside the iframe sandbox."
    },
    "sandboxFlags": {
      "type": "string",
      "default": "allow-scripts allow-same-origin allow-forms",
      "description": "Space-separated sandbox attribute tokens for the iframe element."
    },
    "jwtRequired": {
      "type": "boolean",
      "default": true,
      "description": "Whether a signed JWT must be appended to the embed URL."
    },
    "jwtAudience": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        { "type": "null" }
      ],
      "description": "Expected JWT audience claim for verification."
    },
    "trapFocus": {
      "type": "boolean",
      "default": false,
      "description": "Trap keyboard focus inside the iframe (kiosk mode)."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
