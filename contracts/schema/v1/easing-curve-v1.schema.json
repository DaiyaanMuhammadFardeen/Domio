{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.dev/schema/v1/easing-curve-v1.schema.json",
  "title": "Easing curve",
  "description": "A named easing curve: linear/step/cubic-bezier/spring/physics (Phase 09).",
  "type": "object",
  "required": ["type", "name"],
  "additionalProperties": false,
  "properties": {
    "type": { "enum": ["linear", "step", "cubic-bezier", "spring", "physics"] },
    "name": { "type": "string", "minLength": 1 },
    "steps": { "type": "integer", "minimum": 2, "maximum": 64 },
    "x1": { "type": "number", "minimum": -1, "maximum": 1 },
    "y1": { "type": "number", "minimum": -2, "maximum": 2 },
    "x2": { "type": "number", "minimum": -1, "maximum": 1 },
    "y2": { "type": "number", "minimum": -2, "maximum": 2 },
    "mass": { "type": "number", "minimum": 0.1, "maximum": 10 },
    "stiffness": { "type": "number", "minimum": 10, "maximum": 1000 },
    "damping": { "type": "number", "minimum": 1, "maximum": 200 },
    "initialVelocity": { "type": "number" },
    "kind": { "enum": ["gravity", "throw", "bounce"] }
  }
}
