{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/schemas/v1/license-v1.schema.json",
  "title": "Domio License V1",
  "description": "Stock-media license record for Phase 11. Tracks license source, terms, expiry, seat limits, and metadata for model, video, audio, and Lottie assets.",
  "type": "object",
  "required": ["schemaVersion", "id", "workspaceId", "name", "source", "metadata", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "License source identifier (e.g., 'unsplash', 'pexels', 'user-upload')."
    },
    "termsUrl": {
      "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }],
      "description": "URL of the full license terms."
    },
    "expiresAt": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
      "description": "License expiry timestamp (null for perpetual licenses)."
    },
    "seats": {
      "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }],
      "description": "Maximum number of seats/users covered (null for unlimited)."
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary license metadata (attribution text, purchase order, etc.).",
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
