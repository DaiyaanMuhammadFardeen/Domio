{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/schemas/v1/crdt-op.schema.json",
  "title": "Domio CRDT Operation Envelope",
  "description": "Validates the wire structure of a CRDT operation sent over the realtime WebSocket. The payload field carries raw Yjs update bytes encoded as base64.",
  "type": "object",
  "required": ["opId", "deckId", "branchId", "authorId", "hlc", "opType"],
  "additionalProperties": false,
  "properties": {
    "opId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "description": "ULID — globally unique operation identifier."
    },
    "deckId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "branchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "default": "main"
    },
    "slideId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hlc": {
      "$ref": "#/definitions/HLC"
    },
    "parentHlc": {
      "$ref": "#/definitions/HLC"
    },
    "payload": {
      "type": "string",
      "description": "Base64-encoded Yjs update bytes."
    },
    "clientClock": {
      "type": "integer",
      "description": "Monotonic client clock for ordering within a single client."
    },
    "opType": {
      "type": "string",
      "enum": ["yjs_update", "checkpoint"]
    }
  },
  "definitions": {
    "HLC": {
      "type": "object",
      "required": ["physical", "logical"],
      "additionalProperties": false,
      "properties": {
        "physical": {
          "type": "integer",
          "minimum": 0,
          "description": "Physical component: unix nanoseconds."
        },
        "logical": {
          "type": "integer",
          "minimum": 0,
          "description": "Logical counter: monotonic tie-breaker."
        }
      }
    }
  }
}
