{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.dev/schema/v1/transition-v1.schema.json",
  "title": "Slide transition",
  "description": "A GPU slide transition between two slides (Phase 09).",
  "type": "object",
  "required": ["from_slide_id", "to_slide_id", "kind", "duration_ms", "easing"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "from_slide_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "to_slide_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "kind": { "enum": ["fade", "slide", "zoom", "flip", "cube", "cover", "reveal", "blinds"] },
    "duration_ms": { "type": "integer", "minimum": 50, "maximum": 10000 },
    "easing": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["forward", "backward"] }
  }
}
