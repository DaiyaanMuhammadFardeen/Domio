{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.dev/schema/v1/prototype-event-v1.schema.json",
  "title": "Prototype event",
  "description": "An append-only event in a prototype session's telemetry ledger. Phase 10 M5. Each event is part of a chained HMAC with explicit `prev_hash` → `event_hash` linkage.",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "deck_id",
    "session_id",
    "seq",
    "event_type",
    "payload",
    "prev_hash",
    "event_hash",
    "kid",
    "client_fingerprint",
    "region",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "deck_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "seq": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "session_start",
        "session_end",
        "slide_enter",
        "slide_exit",
        "click",
        "hover",
        "form_submit",
        "calculator_change",
        "rage_click",
        "error",
        "device_frame_change",
        "consent_change"
      ]
    },
    "payload": { "type": "object" },
    "prev_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kid": { "type": "string", "minLength": 1, "maxLength": 64 },
    "client_fingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "region": { "enum": ["us-east", "us-west", "eu-central", "ap-south", "ap-east"] },
    "created_at": { "type": "integer", "minimum": 0 }
  }
}
