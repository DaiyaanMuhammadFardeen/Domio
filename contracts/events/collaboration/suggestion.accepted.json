{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/suggestion.accepted.json",
  "title": "CollabSuggestionAccepted",
  "description": "Emitted when a suggestion is accepted and applied.",
  "type": "object",
  "required": ["event_id", "event_type", "ts_ms", "workspace_id", "actor_id", "actor_type", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "suggestion.accepted"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent", "system"]
    },
    "payload": {
      "type": "object",
      "required": ["suggestion_id", "deck_id", "accepted_by"],
      "properties": {
        "suggestion_id": {
          "type": "string"
        },
        "deck_id": {
          "type": "string"
        },
        "accepted_by": {
          "type": "string"
        }
      }
    }
  }
}
