{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/comment.resolved.json",
  "title": "CollabCommentResolved",
  "description": "Emitted when a comment thread is resolved.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "ts_ms",
    "workspace_id",
    "actor_id",
    "actor_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "comment.resolved"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent"]
    },
    "payload": {
      "type": "object",
      "required": ["comment_id", "thread_id"],
      "properties": {
        "comment_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      }
    }
  }
}
