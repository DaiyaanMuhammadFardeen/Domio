{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/expiry.policy_triggered.json",
  "title": "CollabExpiryPolicyTriggered",
  "description": "Emitted when an expiry policy fires (resource has exceeded its review interval).",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "ts_ms",
    "workspace_id",
    "actor_id",
    "actor_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "expiry.policy_triggered"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent"]
    },
    "payload": {
      "type": "object",
      "required": ["policy_id", "resource_type", "resource_id", "escalation"],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "escalation": {
          "type": "string",
          "enum": ["gentle", "moderate", "strict"]
        }
      }
    }
  }
}
