{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/merge_request.conflict_detected.json",
  "title": "CollabMergeRequestConflictDetected",
  "description": "Emitted when a merge conflict is detected during a merge request.",
  "type": "object",
  "required": ["event_id", "event_type", "ts_ms", "workspace_id", "actor_id", "actor_type", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "merge_request.conflict_detected"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent", "system"]
    },
    "payload": {
      "type": "object",
      "required": ["mr_id", "deck_id", "conflicting_slide_ids"],
      "properties": {
        "mr_id": {
          "type": "string"
        },
        "deck_id": {
          "type": "string"
        },
        "conflicting_slide_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
