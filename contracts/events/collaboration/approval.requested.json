{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/approval.requested.json",
  "title": "CollabApprovalRequested",
  "description": "Emitted when a user submits a deck for multi-lane approval.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "ts_ms",
    "workspace_id",
    "actor_id",
    "actor_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "approval.requested"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent"]
    },
    "payload": {
      "type": "object",
      "required": ["request_id", "deck_id", "version_id", "requested_by", "status"],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "deck_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string",
          "description": "Immutable snapshot/version of the deck under review."
        },
        "requested_by": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "pending", "approved", "rejected", "changes_requested"]
        }
      }
    }
  }
}
