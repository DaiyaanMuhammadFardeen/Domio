{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/auto_update.conflict.json",
  "title": "CollabAutoUpdateConflict",
  "description": "Emitted when an auto-update binding detects a conflict (local edits vs library update).",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "ts_ms",
    "workspace_id",
    "actor_id",
    "actor_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "auto_update.conflict"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent"]
    },
    "payload": {
      "type": "object",
      "required": ["binding_id", "consumer_slide_id", "reason"],
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "consumer_slide_id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "Human-readable conflict reason."
        }
      }
    }
  }
}
