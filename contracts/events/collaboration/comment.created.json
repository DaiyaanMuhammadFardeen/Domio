{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/comment.created.json",
  "title": "CollabCommentCreated",
  "description": "Emitted when a user creates a new comment on a deck, slide, or element.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "ts_ms",
    "workspace_id",
    "actor_id",
    "actor_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "comment.created"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent"]
    },
    "payload": {
      "type": "object",
      "required": ["comment_id", "thread_id", "body_md"],
      "properties": {
        "comment_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "body_md": {
          "type": "string"
        },
        "anchor": {
          "type": "object",
          "description": "Optional anchor with element/slide coordinates.",
          "properties": {
            "element": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            },
            "slide": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          }
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mentioned_id", "mentioned_type"],
            "properties": {
              "mentioned_id": { "type": "string" },
              "mentioned_type": { "type": "string", "enum": ["user", "role", "group"] }
            }
          }
        }
      }
    }
  }
}
