{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/collaboration/expiry.flag_applied.json",
  "title": "CollabExpiryFlagApplied",
  "description": "Emitted when a freshness flag is applied to a resource.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "ts_ms",
    "workspace_id",
    "actor_id",
    "actor_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "event_type": {
      "type": "string",
      "const": "expiry.flag_applied"
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["member", "guest", "agent"]
    },
    "payload": {
      "type": "object",
      "required": ["flag_id", "resource_type", "resource_id", "reason"],
      "properties": {
        "flag_id": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": ["policy_overdue", "manual", "ai_detected"]
        }
      }
    }
  }
}
