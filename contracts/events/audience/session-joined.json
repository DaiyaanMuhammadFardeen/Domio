{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domio.example/contracts/events/audience/session-joined.json",
  "title": "AudienceSessionJoined",
  "description": "Emitted by the audience service when a participant joins a session. The audience_session_id is the gateway-assigned participant handle; session_id is the presenter session. The pair is used by the WS gateway to index state.",
  "type": "object",
  "required": ["event_id", "ts_ms", "workspace_id", "session_id", "audience_session_id", "participant_id", "session_code", "shard_index", "locale"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally-unique ULID."
    },
    "ts_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "audience_session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "session_code": {
      "type": "string"
    },
    "shard_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "locale": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "fingerprint_hash": {
      "type": "string",
      "description": "SHA-256 of the browser fingerprint; never the plaintext fingerprint."
    }
  }
}